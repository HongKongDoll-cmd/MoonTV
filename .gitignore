# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# 迁移/重装 node_modules 时留下的备份目录（内容是依赖包自己的测试文件，
# 会被 jest 与 tsc 的 `**/*.ts` 通配扫进来，务必忽略）
/node_modules.old
/node_modules.partial
/node_modules.backup*
# 生成补丁时的临时基线副本（git init + 整棵树），删不掉时会留在项目根
/.patch-tmp
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# IDE
.vscode

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# next-sitemap
sitemap.xml
sitemap-*.xml

# generated files
src/lib/runtime.ts
public/manifest.json
/.vs

# next-pwa 构建产物（public/sw.js 本身仍然入库，供 Cloudflare / Vercel 构建使用；
# 本地与 Docker 构建由 scripts/restore-sw.js 负责还原，见 P2-12）
public/workbox-*.js
public/workbox-*.js.map
public/worker-*.js
public/sw.js.map
docs/p422-player-enhancements.patch
docs/p423-theme-palette.patch
docs/p424-play-view-state.patch
docs/p4244-theme-palette-fix.patch
docs/fixtures/today-updated-sample.json
docs/tools/check-notifications.mjs
